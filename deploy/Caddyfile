# Caddy gets and renews the HTTPS certificate for $DOMAIN automatically.
{$DOMAIN} {
	encode zstd gzip

	# The app's requests are small JSON; refuse anything bigger before it reaches the app.
	request_body {
		max_size 64KB
	}

	reverse_proxy reposcout:8000 {
		# The app trusts only this header for the visitor's address (X-Forwarded-For can be
		# extended by the visitor, so it isn't used for rate limits).
		header_up X-Real-IP {remote_host}
		# Reviews on free API keys can take a while; don't cut them off.
		transport http {
			read_timeout 5m
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}
}
