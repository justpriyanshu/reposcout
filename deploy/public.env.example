# Copy to deploy/public.env and edit. This file is read by docker compose.

# Your domain, e.g. reposcout.duckdns.org (must point at this server's public IP)
DOMAIN=yourname.duckdns.org

# Optional: a GitHub token raises GitHub's API limit for this server from 60 to 5,000
# requests per hour. Create a fine-grained token with "Public repositories (read-only)".
GITHUB_TOKEN=

# The chat API visitors' own keys are used with (Groq by default).
REPOSCOUT_OPENAI_BASE_URL=https://api.groq.com/openai/v1
REPOSCOUT_PUBLIC_PROVIDER_NAME=Groq
REPOSCOUT_PUBLIC_KEY_URL=https://console.groq.com/keys
REPOSCOUT_PUBLIC_DEFAULT_MODEL=openai/gpt-oss-20b

# Optional: keep the registry and indexes in Postgres with pgvector instead of /data
# (e.g. a free Neon database). Leave empty to use files in the reposcout_data volume.
REPOSCOUT_DATABASE_URL=

# Optional "Sign in with GitHub" (a GitHub OAuth App; callback https://$DOMAIN/auth/github/callback)
REPOSCOUT_GITHUB_CLIENT_ID=
REPOSCOUT_GITHUB_CLIENT_SECRET=
REPOSCOUT_PUBLIC_URL=https://yourname.duckdns.org

# Optional monitoring
SENTRY_DSN=

# Limits that keep a small server healthy
REPOSCOUT_MAX_REPO_MB=80
REPOSCOUT_MAX_FILES=3000
REPOSCOUT_MAX_CHUNKS=12000
REPOSCOUT_MAX_REPOS=30
REPOSCOUT_LIMIT_INDEX_PER_HOUR=6
REPOSCOUT_LIMIT_LLM_PER_10MIN=40
REPOSCOUT_LIMIT_SEARCH_PER_10MIN=120

# How much work the server does at once (extra requests get a "busy, try again")
REPOSCOUT_MAX_CONCURRENT_LLM=4
REPOSCOUT_MAX_CONCURRENT_SEARCH=4
REPOSCOUT_MAX_QUEUED=8
REPOSCOUT_INDEX_TIMEOUT_MINUTES=20
