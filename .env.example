# Copy to .env and adjust. All values are optional; defaults assume a local Ollama.

# Repository to index and serve
REPOSCOUT_REPO_PATH=.

# Embeddings: ollama | openai | hash
REPOSCOUT_EMBED_PROVIDER=ollama
REPOSCOUT_EMBED_MODEL=nomic-embed-text

# Chat model: ollama | openai (any OpenAI-compatible API)
REPOSCOUT_LLM_PROVIDER=ollama
REPOSCOUT_LLM_MODEL=qwen2.5-coder:7b
REPOSCOUT_OLLAMA_URL=http://localhost:11434

# For REPOSCOUT_LLM_PROVIDER=openai
REPOSCOUT_OPENAI_BASE_URL=https://api.groq.com/openai/v1
REPOSCOUT_OPENAI_API_KEY=

# GitHub integration
GITHUB_TOKEN=
REPOSCOUT_WEBHOOK_SECRET=
