# Copy to .env and adjust. All values are optional; defaults assume a local Ollama.

# Repository to index and serve
REPOSCOUT_REPO_PATH=.

# Embeddings: ollama | jina | openai | hash (empty model = the provider's default)
REPOSCOUT_EMBED_PROVIDER=ollama
REPOSCOUT_EMBED_MODEL=nomic-embed-text
# For jina embeddings or reranking (https://jina.ai, free tokens, non-commercial use)
REPOSCOUT_JINA_API_KEY=
# Rerank the top search results: none | jina
REPOSCOUT_RERANK_PROVIDER=none

# Chat model: ollama | openai (any OpenAI-compatible API)
REPOSCOUT_LLM_PROVIDER=ollama
REPOSCOUT_LLM_MODEL=qwen2.5-coder:7b
REPOSCOUT_OLLAMA_URL=http://localhost:11434

# For REPOSCOUT_LLM_PROVIDER=openai
REPOSCOUT_OPENAI_BASE_URL=https://api.groq.com/openai/v1
REPOSCOUT_OPENAI_API_KEY=

# Backup models when the main one is rate limited or down, e.g.
# gemini:gemini-2.5-flash,openrouter:qwen/qwen3-coder:free (keys below)
REPOSCOUT_LLM_FALLBACKS=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Static analysers in reviews: bandit, gitleaks, semgrep (missing tools are skipped)
REPOSCOUT_SCANNERS=bandit,gitleaks

# GitHub integration
GITHUB_TOKEN=
REPOSCOUT_WEBHOOK_SECRET=

# Monitoring (pip install 'reposcout[observability]')
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
